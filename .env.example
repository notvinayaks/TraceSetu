# Copy to .env only when configuring an installation. Never commit .env.
# Defaults bind to local-only development through the launch script.
ATLAS_LOCAL_BOOTSTRAP=true
ATLAS_SECURE_COOKIE=false
ATLAS_WORKER_ENABLED=true
ATLAS_SESSION_HOURS=8
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:CHANGE_ME@localhost:5432/atlas
# ATLAS_DATA_DIR=/var/lib/atlas
# Use HTTPS and secure cookies for operational access.
ATLAS_ALLOWED_HOSTS=127.0.0.1,localhost
ATLAS_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:5173,http://localhost:5173
ATLAS_ETHERSCAN_API_KEY=
# Enable only with the Etherscan Pro Plus metadata entitlement.
ATLAS_ETHERSCAN_METADATA_ENABLED=false
# Read-only CCTP V2 Ethereum/Polygon USDC correlation; requires Etherscan access.
# Synthetic tests pass; live endpoint/contract validation is still pending.
ATLAS_CCTP_ENABLED=false
ATLAS_TRONGRID_API_KEY=
ATLAS_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ATLAS_BITCOIN_API_URL=https://mempool.space/api
# Explicit provider selection; there is no automatic or synthetic fallback.
ATLAS_BITCOIN_PROVIDER=esplora
# Optional public alternative: set ATLAS_BITCOIN_PROVIDER=blockcypher
ATLAS_BLOCKCYPHER_API_URL=https://api.blockcypher.com/v1/btc/main
ATLAS_PROVIDER_TIMEOUT=15
